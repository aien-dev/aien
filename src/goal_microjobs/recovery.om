om2
note SPDX-License-Identifier: AGPL-3.0-or-later
note One-node M1 recovery: effective operand and exact RESULT identity.
global Ib uchar 65536
global Pos ulong 2
global Ob uchar 8192
global Op ulong 1
text conflict "RECOVERY_RESULT_CONFLICT\n"
fn die c int to void
exit c
end
fn ws c uchar to bool
ret or eq c 32 or eq c 10 or eq c 13 eq c 9
end
fn word to ulong
p = get Pos 0
while lt p get Pos 1 bound 65536
if not ws get Ib p
break
end
p = add p 1
end
if eq p get Pos 1
die 2
end
v = ulong 0
while lt p get Pos 1 bound 65536
c = get Ib p
if ws c
break
end
if or lt c 48 gt c 57
die 2
end
d = ulong sub c 48
if or gt v 1844674407370955161 and eq v 1844674407370955161 gt d 5
die 2
end
v = add mul v 10 d
p = add p 1
end
put Pos 0 p
ret v
end
fn digit v ulong to void
if gt v 9
digit div v 10
end
put Ob get Op 0 uchar add rem v 10 48
put Op 0 add get Op 0 1
end
fn dec v ulong to void
digit v
put Ob get Op 0 32
put Op 0 add get Op 0 1
end
fn checkresult a view ulong 14 b view ulong 14 to void
for i ulong 14
if ne get a i get b i
w = write 2 conflict 0 len conflict
die 33
end
end
end
fn main to int
a = new ulong 75 0
e = new ulong 14 0
b = new ulong 14 0
n = ulong 0
while lt n len Ib bound 65536
r = read 0 Ib n sub len Ib n
if lt r 0
die 3
end
if eq r 0
break
end
n = add n ulong r
end
put Pos 1 n
mode = word
if eq mode 1
count = word
if gt count 256
die 2
end
for i ulong 75
put a i word
end
for i ulong count
for j ulong 14
put e j word
end
if and eq get e 2 6 eq get e 3 1
for j ulong 4
put a add 35 j get e add 8 j
end
end
end
for i ulong 75
dec get a i
end
put Ob get Op 0 10
put Op 0 add get Op 0 1
w = write 1 Ob 0 get Op 0
ret 0
end
if eq mode 2
for i ulong 14
put e i word
end
for i ulong 14
put b i word
end
note RECOVERY-GUARD result-conflict
checkresult e b
ret 0
end
ret 2
end
