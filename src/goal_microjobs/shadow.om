note SPDX-License-Identifier: AGPL-3.0-or-later
note NL5 synthetic shadow proposal producer, not an executor or authority.
note Opt-in exact CLI: --private-local-shadow A|B|C SCENARIO
note stdout is the existing Allen-local plan+journal adapter, stderr metadata.
note No input traces, filesystem writes, sockets, models, Cortex or effect calls.
note C is unavailable pending NL3 CONTENT binding and NL4 consumer integration.
note Unsupported C proposals fall back to B before admission, never to effects.
text opt "--private-local-shadow"
text meta "NL5 HOST_ONLY synthetic Allen identity=9 owner=7 effects=0\n"
text cf "C NOT_RUN adapter_unavailable fallback=B\n"
text af "A deterministic_text_stub tokens=NOT_RUN\n"
text bf "B deterministic_typed_stub tokens=0\n"
global Arg uchar 64
global Buf uchar 16384
global Pos ulong 1
global Seq ulong 1
global Val ulong 12
global Gen ulong 12
global Ref ulong 24
global Cfg ulong 3
global Msg uchar 128
global Mp ulong 2
global Bytes ulong 1

fn out v ulong to void
if gt v 9
out div v 10
end
put Buf get Pos 0 uchar add rem v 10 48
put Pos 0 add get Pos 0 1
end
fn word v ulong to void
out v
put Buf get Pos 0 32
put Pos 0 add get Pos 0 1
end
fn line to void
put Buf sub get Pos 0 1 10
end
fn flushout to int
p = ulong 0
while lt p get Pos 0 bound 16384
w = write 1 Buf p sub get Pos 0 p
if le w 0
ret 74
end
p = add p ulong w
end
ret 0
end
fn args to bool
if ne argcnt 4
ret false
end
n = argread 1 Arg 0 64
if ne n long len opt
ret false
end
for i ulong len opt
if ne get Arg i get opt i
ret false
end
end
n = argread 2 Arg 0 64
if ne n 1
ret false
end
a = get Arg 0
if or lt a 65 gt a 67
ret false
end
put Cfg 0 ulong a
n = argread 3 Arg 0 64
if ne n 1
ret false
end
s = get Arg 0
if or lt s 48 gt s 57
ret false
end
put Cfg 1 sub ulong s 48
ret true
end
fn headerout to void
word 1
word 1
word 19
word 0
word 0
word 0
word 7
word 9
word 0
word 12
word 11
word 32
if eq get Cfg 1 7
word 0
else
word 8
end
word 640
word 64
word 16
word 1200
line
end
fn nodeout i ulong to void
word 2
word i
if eq i 4
word 2
word 1
word 1
word 1
else
word 1
word 1
word 0
word 0
end
word 0
if eq i 4
word 64
word 16
word 1
word 1
else
word 0
word 0
word 0
word 0
end
word 1
word 5
word 2
word 2
word 7
word 100
if eq i 12
word 0
else
word 1
end
word i
word 0
word 0
word 0
if eq i 5
word 4
word 1
word 2
word 3
word 4
else
if gt i 5
word 1
word sub i 1
else
word 0
end
end
line
end
fn emit kind ulong node ulong who ulong value ulong verdict ulong to void
put Seq 0 add get Seq 0 1
word 3
word get Seq 0
word kind
word node
if or eq kind 7 or eq kind 6 eq kind 5
word 0
else
word 1
end
word get Gen sub node 1
word who
word verdict
word value
word 0
word 0
word 0
word 0
word 0
line
end
note Two deterministic specialist transports; all operands are serialized and decoded.
note No language model or continuous latent transport is represented by these stubs.
fn mdigit v ulong to void
if gt v 9
mdigit div v 10
end
put Msg get Mp 0 uchar add rem v 10 48
put Mp 0 add get Mp 0 1
end
fn mread to ulong
v = ulong 0
while lt get Mp 1 get Mp 0 bound 128
c = get Msg get Mp 1
put Mp 1 add get Mp 1 1
if eq c 32
ret v
end
if or lt c 48 gt c 57
exit 66
end
v = add mul v 10 sub ulong c 48
end
ret v
end
fn mstore off ulong v ulong to void
for j ulong 8
put Msg add off j uchar and shr v mul j 8 255
end
end
fn mload off ulong to ulong
v = ulong 0
for j ulong 8
v = or v shl ulong get Msg add off j mul j 8
end
ret v
end
fn specialist x ulong y ulong to ulong
note Shared work budget counts every specialist attempt, including fallback.
if ge get Cfg 2 32
exit 68
end
put Cfg 2 add get Cfg 2 1
if or gt x 100 gt y 100
exit 66
end
if eq get Cfg 0 65
put Msg 0 97
put Msg 1 100
put Msg 2 100
put Msg 3 32
put Mp 0 4
mdigit x
put Msg get Mp 0 32
put Mp 0 add get Mp 0 1
mdigit y
put Bytes 0 add get Bytes 0 get Mp 0
if or ne get Msg 0 97 or ne get Msg 1 100 ne get Msg 2 100
exit 66
end
put Mp 1 4
a = mread
b = mread
ret add a b
end
mstore 0 1
mstore 8 x
mstore 16 y
put Bytes 0 add get Bytes 0 24
if ne mload 0 1
exit 66
end
ret add mload 8 mload 16
end
fn compute i ulong corr bool to ulong
if eq i 1
ret specialist 3 5
end
if eq i 2
ret specialist 4 7
end
if eq i 3
if corr
ret specialist 6 9
end
ret specialist 6 8
end
if eq i 4
ret specialist 9 2
end
if eq i 5
v = add get Val 0 get Val 1
v = add v get Val 2
ret specialist v get Val 3
end
ret specialist get Val sub i 2 sub i 5
end
fn errbyte c uchar to void
put Arg 0 c
w = write 2 Arg 0 1
if ne w 1
exit 74
end
end
fn errnum v ulong to void
if gt v 9
errnum div v 10
end
errbyte uchar add rem v 10 48
end
fn hop i ulong bytes ulong to void
errnum 201
errbyte 32
errnum i
errbyte 32
errnum get Cfg 0
errbyte 32
errnum bytes
errbyte 10
end
fn runnode i ulong corr bool to bool
before = get Bytes 0
v = compute i corr
if and eq get Cfg 1 4 eq i 4
v = add v 1
if eq get Cfg 0 67
note Deterministic bad-proposal stub, not a learned latent message.
note Independent oracle must refuse it before typed fallback recomputation.
if eq v get Ref 3
exit 67
end
errnum 202
errbyte 32
errnum 4
errbyte 10
v = compute i corr
end
end
hop i sub get Bytes 0 before
emit 1 i 20 0 0
emit 2 i 20 v 0
idx = sub i 1
if corr
idx = add idx 12
end
if ne v get Ref idx
emit 3 i 5 v 0
ret false
end
emit 3 i 5 v 1
put Val sub i 1 v
ret true
end
fn main to int
if eq args false
ret 64
end
w = write 2 meta 0 len meta
if ne w long len meta
ret 74
end
if eq get Cfg 0 67
w = write 2 cf 0 len cf
if ne w long len cf
ret 74
end
else
if eq get Cfg 0 65
w = write 2 af 0 len af
if ne w long len af
ret 74
end
else
w = write 2 bf 0 len bf
if ne w long len bf
ret 74
end
end
end
oracle
headerout
for j ulong 12
nodeout add j 1
put Gen j 1
end
if eq get Cfg 1 5
emit 1 5 20 0 0
ret flushout
end
if eq get Cfg 1 2
emit 5 5 7 0 0
ret flushout
end
for j ulong 11
if eq runnode add j 1 false false
r = flushout
if ne r 0
ret r
end
ret 65
end
if and eq get Cfg 1 3 eq j 3
ret flushout
end
end
emit 7 12 9 0 0
if eq get Cfg 1 1
emit 6 3 7 99 0
put Gen 2 2
for j ulong 7
put Gen add j 4 2
end
ok = runnode 3 true
if eq ok false
ret 65
end
for j ulong 7
ok = runnode add j 5 true
if eq ok false
ret 65
end
end
end
if eq get Cfg 1 6
emit 6 3 20 99 0
end
if eq get Cfg 1 8
emit 8 11 9 777 0
end
if eq get Cfg 1 9
emit 2 11 20 get Val 10 0
end
ret flushout
end
